@model ListePaginee<JournalAudit>
@{
    ViewData["Title"] = "Journal d'audit";
    var q = ViewData["q"] as string;
}

<header class="entete">
    <div>
        <h1>Journal d'audit</h1>
        <p class="entete__resume">@Formats.Pluriel(Model.Total, "événement") · toutes les écritures et connexions. Heures en UTC.</p>
    </div>
</header>

<form method="get" class="filtres" role="search">
    <label class="filtres__recherche">
        <span class="sr">Rechercher dans le journal</span>
        <input type="search" name="q" value="@q" placeholder="Auteur, action, entité ou détail" data-recherche />
        <kbd>/</kbd>
    </label>
    <button class="btn" type="submit">Rechercher</button>
    @if (!string.IsNullOrEmpty(q))
    {
        <a asp-action="Index" class="btn btn--lien">Effacer</a>
    }
</form>

@if (Model.Total == 0)
{
    <p class="vide">Aucun événement.</p>
}
else
{
    <div class="defilement">
        <table class="registre">
            <thead>
                <tr><th>Date</th><th>Auteur</th><th>Action</th><th>Élément</th><th>Détails</th></tr>
            </thead>
            <tbody>
                @foreach (var j in Model.Elements)
                {
                    <tr>
                        <td class="mono">@j.DateUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@j.Auteur</td>
                        <td>@j.Action</td>
                        <td class="mono">@j.Entite @(j.EntiteId == null ? "" : $"#{j.EntiteId}")</td>
                        <td class="discret">@j.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="Model" />
}
