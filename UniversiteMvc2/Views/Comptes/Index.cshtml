@model List<Compte>
@{
    ViewData["Title"] = "Comptes";
    var etudiants = (bool)ViewData["etudiants"]!;
}

<header class="entete">
    <div>
        <h1>Comptes</h1>
        <p class="entete__resume">
            @Formats.Pluriel(Model.Count, etudiants ? "compte étudiant" : "compte du personnel", etudiants ? "comptes étudiants" : "comptes du personnel")
            · @(etudiants ? "créés par les étudiants (inscription en ligne ou activation), limités à leur espace." : "ce que chaque profil peut faire se règle dans Permissions.")
        </p>
    </div>
    <div class="entete__actions">
        <a asp-controller="Permissions" asp-action="Index" class="btn">Permissions</a>
        <a asp-action="Create" class="btn btn--plein">Nouveau compte</a>
    </div>
</header>

<nav class="filtres" aria-label="Type de comptes">
    <a asp-action="Index" class="btn @(etudiants ? "btn--lien" : null)" aria-current="@(etudiants ? null : "page")">Personnel</a>
    <a asp-action="Index" asp-route-etudiants="true" class="btn @(etudiants ? null : "btn--lien")" aria-current="@(etudiants ? "page" : null)">Étudiants</a>
</nav>

<div class="defilement">
    <table class="registre">
        <thead>
            <tr>
                <th>Nom</th>
                <th>E-mail</th>
                <th>@(etudiants ? "Matricule" : "Profil")</th>
                <th>État</th>
                <th>Dernière connexion</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                var verrouille = c.VerrouilleJusquA > DateTime.UtcNow;
                <tr>
                    <td><a asp-action="Edit" asp-route-id="@c.Id" class="lien-fort">@c.Nom</a></td>
                    <td class="discret">@c.Email</td>
                    <td class="@(etudiants ? "mono" : null)">@(etudiants ? c.Etudiant?.Matricule : c.Role)</td>
                    <td>@(!c.Actif ? "Désactivé" : verrouille ? "Verrouillé" : c.DoitChangerMotDePasse ? "Mot de passe provisoire" : "Actif")</td>
                    <td class="discret">@(c.DerniereConnexion == null ? "—" : Formats.Date(c.DerniereConnexion.Value))</td>
                    <td class="actions">
                        <form asp-action="Reinitialiser" asp-route-id="@c.Id" method="post">
                            <button type="submit" class="btn btn--lien">Réinitialiser le mot de passe</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
